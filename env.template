# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para event-orders/.env.local e preencha os valores.
# NUNCA commite o .env.local — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_URL=
# DIRECT_URL=

# ── Prazo de pedidos ──────────────────────────────────────────────────────────
# ISO 8601 com fuso horário. Pedidos são bloqueados após este momento.
# Banner de aviso aparece 48h antes.
# Produção: 2026-09-23T23:59:00-03:00
# Teste (ver banner imediatamente): ~48h a partir de agora
EVENT_CUTOFF=2026-09-23T23:59:00-03:00

# ── Painel Admin ──────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Pedidos

# ── InfinitePay ───────────────────────────────────────────────────────────────
# Handle da conta InfinitePay (não é segredo, mas fica em config para flexibilidade)
INFINITEPAY_HANDLE=

# Base URL da API InfinitePay
INFINITEPAY_API_URL=

# Token aleatório e longo embutido na URL do webhook (único controle de acesso).
INFINITEPAY_WEBHOOK_TOKEN=

# ── URLs da aplicação ─────────────────────────────────────────────────────────
# Usada para montar redirect_url e webhook_url enviados à InfinitePay.
# Local: 
# Produção: 
BASE_URL=http://localhost:3000
# IMPORTANTE: sem barra no final. Uma barra final gera //api/webhooks/... e o
# webhook da InfinitePay cai em 404, deixando o pedido preso em AWAITING_PAYMENT.
